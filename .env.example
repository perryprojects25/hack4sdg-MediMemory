# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI for the doctor summary. Any OpenAI-compatible provider works.
# Google Gemini (free tier): get a key at https://aistudio.google.com/apikey
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
# Name shown to caregivers in the consent notice
NEXT_PUBLIC_AI_PROVIDER_NAME=Google Gemini

# Alternative: DeepSeek (paid). Used only if AI_API_KEY is empty.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: protects the daily missed-dose job (/api/cron/sweep). Any long random text.
CRON_SECRET=
