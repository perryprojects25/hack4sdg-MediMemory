# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (doctor summary and medicine safety check). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models tried in order
GEMINI_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite

# Optional: protects the daily missed-dose job (/api/cron/sweep). Any long random text.
CRON_SECRET=

# Hackathon demo mode: true = no sign-in at all. Everyone uses the fixed demo caregiver
# (lib/demo-mode.ts) and no sign-in emails are ever sent. Set to false to use real sign-in.
DEMO_MODE=true
